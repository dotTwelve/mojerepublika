---
interface HistoryPoint {
  year: number;
  value: number;
}

interface Details {
  chartType?: string;
  chartLabel?: string;
  history?: HistoryPoint[];
}

interface Props {
  id: string;
  label: string;
  value: string | number;
  unit?: string;
  description?: string;
  change?: number;
  source?: string;
  highlight?: boolean;
  details?: Details;
}

const { id, label, value, unit, description, change, source, highlight = false, details } = Astro.props;

const hasDetails = details && details.history && details.history.length > 0;
---

<article
  class:list={[
    'stat-card group relative bg-white border border-border rounded-xl p-6 transition-all duration-200 overflow-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:outline-none',
    highlight ? 'ring-1 ring-accent/20 bg-gradient-to-br from-white to-surface' : '',
    hasDetails ? 'hover:shadow-md hover:border-accent/40 cursor-pointer' : 'hover:shadow-sm'
  ]}
  data-stat-id={id}
  data-has-details={hasDetails ? 'true' : 'false'}
  data-stat-details={hasDetails ? JSON.stringify(details) : ''}
  data-stat-label={label}
  data-stat-value={String(value)}
  data-stat-unit={unit || ''}
  data-stat-description={description || ''}
  data-stat-change={change !== undefined ? String(change) : ''}
  data-stat-source={source || ''}
  role={hasDetails ? 'button' : undefined}
  tabindex={hasDetails ? 0 : undefined}
>
  <!-- Top accent bar for cards with details -->
  {hasDetails && (
    <div class="absolute top-0 left-0 right-0 h-[3px] bg-accent/30 group-hover:bg-accent transition-colors duration-200"></div>
  )}

  <span class="text-xs font-semibold text-muted uppercase tracking-wider">
    {label}
  </span>

  <div class="font-display text-3xl sm:text-4xl lg:text-3xl xl:text-4xl font-bold text-czech-blue mt-2 leading-none tabular-nums">
    {value}
    {unit && <span class="text-base text-muted font-body font-normal ml-1">{unit}</span>}
  </div>

  {description && (
    <p class="text-muted text-sm mt-3 leading-relaxed">
      {description}
    </p>
  )}

  {change !== undefined && (
    <span
      class:list={[
        'inline-flex items-center gap-1 text-sm font-semibold mt-3 px-2 py-0.5 rounded tabular-nums',
        change >= 0 ? 'bg-emerald-50 text-emerald-700' : 'bg-red-50 text-czech-red'
      ]}
    >
      {change >= 0 ? '↑ +' : '↓ −'}{Math.abs(change)}%
    </span>
  )}

  {source && (
    <cite class="block text-xs text-muted/60 mt-2 not-italic">
      Zdroj: {source}
    </cite>
  )}

  <!-- Chart icon -->
  {hasDetails && (
    <div class="absolute top-4 right-4 text-accent/40 group-hover:text-accent transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
      </svg>
    </div>
  )}
</article>

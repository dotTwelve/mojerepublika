---
// Takeover detail view
// Clicking a stat card replaces the grid with a full-width detail card
// Uses Chart.js — lightweight, canvas-based, responsive
---

<!-- Takeover panel (inserted into DOM dynamically) -->
<template id="stat-takeover-template">
  <div class="stat-takeover">
    <!-- Close button -->
    <button class="takeover-close inline-flex items-center gap-2 text-sm text-muted hover:text-czech-blue mb-6 group transition-colors">
      <svg class="w-4 h-4 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
      Zpět na přehled
    </button>

    <!-- Detail card -->
    <div class="bg-white border border-border rounded-2xl overflow-hidden">
      <!-- Header -->
      <div class="p-4 sm:p-8 border-b border-border">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
          <div>
            <span class="takeover-label text-xs font-semibold text-muted uppercase tracking-wider"></span>
            <div class="flex items-baseline gap-2 mt-2">
              <span class="takeover-value font-display text-3xl sm:text-5xl lg:text-6xl font-bold text-czech-blue tabular-nums"></span>
              <span class="takeover-unit text-base sm:text-xl text-muted"></span>
            </div>
          </div>
          <div class="takeover-change-wrapper hidden">
            <span class="takeover-change inline-flex items-center gap-1 text-sm font-semibold px-3 py-1 rounded-lg tabular-nums"></span>
          </div>
        </div>
        <p class="takeover-description text-muted mt-4 leading-relaxed max-w-2xl"></p>
      </div>

      <!-- Chart -->
      <div class="p-4 sm:p-8">
        <h3 class="takeover-chart-title text-sm font-semibold text-muted mb-4">Historický vývoj</h3>
        <div class="takeover-chart-wrapper relative w-full" style="height: 280px;">
          <canvas class="takeover-chart"></canvas>
        </div>
      </div>

      <!-- Full data table -->
      <div class="px-4 sm:px-8 pb-4 sm:pb-8">
        <div class="border border-border rounded-xl overflow-hidden">
          <table class="takeover-table w-full text-sm">
            <thead>
              <tr class="bg-surface">
                <th class="text-left px-3 sm:px-4 py-2.5 text-xs font-semibold text-muted uppercase tracking-wider">Rok</th>
                <th class="text-right px-3 sm:px-4 py-2.5 text-xs font-semibold text-muted uppercase tracking-wider">Hodnota</th>
                <th class="text-right px-3 sm:px-4 py-2.5 text-xs font-semibold text-muted uppercase tracking-wider hidden sm:table-cell">Změna</th>
              </tr>
            </thead>
            <tbody class="takeover-tbody tabular-nums"></tbody>
          </table>
        </div>
      </div>

      <!-- Source -->
      <div class="takeover-source-wrapper hidden px-4 sm:px-8 pb-4 sm:pb-8">
        <span class="text-xs text-muted/60">Zdroj: </span>
        <span class="takeover-source text-xs text-muted"></span>
      </div>
    </div>
  </div>
</template>

<script>
  interface HistoryPoint {
    year: number;
    value: number;
  }

  interface Details {
    chartType?: string;
    chartLabel?: string;
    history?: HistoryPoint[];
  }

  let ChartModule: any = null;
  let activeChartInstance: any = null;
  let activeGrid: HTMLElement | null = null;
  let activeTakeover: HTMLElement | null = null;

  async function loadChartJS() {
    if (!ChartModule) {
      const { Chart, registerables } = await import('chart.js');
      Chart.register(...registerables);
      ChartModule = Chart;
    }
    return ChartModule;
  }

  function generateAriaLabel(data: HistoryPoint[], label: string): string {
    if (!data.length) return label;
    const first = data[0];
    const last = data[data.length - 1];
    const trend = last.value > first.value ? 'rostoucí' : last.value < first.value ? 'klesající' : 'stabilní';
    return `${label}: ${trend} trend od ${first.year} (${first.value.toLocaleString('cs-CZ')}) do ${last.year} (${last.value.toLocaleString('cs-CZ')})`;
  }

  async function renderChart(canvas: HTMLCanvasElement, data: HistoryPoint[], label: string) {
    const Chart = await loadChartJS();
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (activeChartInstance) {
      activeChartInstance.destroy();
      activeChartInstance = null;
    }

    canvas.setAttribute('role', 'img');
    canvas.setAttribute('aria-label', generateAriaLabel(data, label));

    const ctx = canvas.getContext('2d')!;

    // Gradient fill
    const gradient = ctx.createLinearGradient(0, 0, 0, canvas.parentElement!.offsetHeight);
    gradient.addColorStop(0, 'rgba(3, 105, 161, 0.2)');
    gradient.addColorStop(1, 'rgba(3, 105, 161, 0.02)');

    activeChartInstance = new Chart(ctx, {
      type: 'line',
      data: {
        labels: data.map(d => d.year.toString()),
        datasets: [{
          label: label,
          data: data.map(d => d.value),
          borderColor: '#0369A1',
          backgroundColor: gradient,
          borderWidth: 2.5,
          fill: true,
          tension: 0.35,
          pointBackgroundColor: '#0369A1',
          pointBorderColor: '#fff',
          pointBorderWidth: 2,
          pointRadius: 4,
          pointHoverRadius: 7,
          pointHoverBackgroundColor: '#0369A1',
          pointHoverBorderColor: '#fff',
          pointHoverBorderWidth: 2,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: {
          duration: reducedMotion ? 0 : 600,
        },
        interaction: {
          intersect: false,
          mode: 'index',
        },
        plugins: {
          legend: {
            display: false,
          },
          tooltip: {
            backgroundColor: 'rgba(15, 23, 42, 0.95)',
            titleFont: { family: 'Inter, sans-serif', size: 12 },
            bodyFont: { family: 'Inter, sans-serif', size: 13, weight: '600' },
            padding: { top: 8, bottom: 8, left: 12, right: 12 },
            cornerRadius: 8,
            displayColors: false,
            callbacks: {
              label: (ctx: any) => ctx.parsed.y.toLocaleString('cs-CZ'),
            }
          },
        },
        scales: {
          x: {
            grid: {
              color: '#E2E8F0',
              drawTicks: false,
            },
            border: {
              display: false,
            },
            ticks: {
              color: '#94A3B8',
              font: { family: 'Inter, sans-serif', size: 11 },
              padding: 8,
            },
          },
          y: {
            grid: {
              color: '#E2E8F0',
              drawTicks: false,
            },
            border: {
              display: false,
            },
            ticks: {
              color: '#94A3B8',
              font: { family: 'Inter, sans-serif', size: 11 },
              padding: 8,
              callback: (v: any) => Number(v).toLocaleString('cs-CZ'),
            },
          },
        },
      },
    });
  }

  function populateTable(takeover: HTMLElement, data: HistoryPoint[]) {
    const tbody = takeover.querySelector('.takeover-tbody');
    if (!tbody) return;

    const reversed = [...data].reverse();
    tbody.innerHTML = reversed.map((d, i) => {
      const prev = i < reversed.length - 1 ? reversed[i + 1] : null;
      let changeHtml = '<td class="text-right px-3 sm:px-4 py-2 hidden sm:table-cell text-muted">—</td>';
      if (prev && prev.value !== 0) {
        const pct = ((d.value - prev.value) / prev.value * 100).toFixed(1);
        const num = parseFloat(pct);
        const color = num >= 0 ? 'text-emerald-600' : 'text-red-600';
        const sign = num >= 0 ? '+' : '';
        changeHtml = `<td class="text-right px-3 sm:px-4 py-2 hidden sm:table-cell ${color}">${sign}${pct}%</td>`;
      }
      return `
        <tr class="border-t border-border/50 hover:bg-surface/50 transition-colors">
          <td class="px-3 sm:px-4 py-2 text-czech-blue-dark font-medium">${d.year}</td>
          <td class="text-right px-3 sm:px-4 py-2 font-semibold text-czech-blue">${d.value.toLocaleString('cs-CZ')}</td>
          ${changeHtml}
        </tr>`;
    }).join('');
  }

  function closeTakeover() {
    if (!activeGrid || !activeTakeover) return;

    if (activeChartInstance) {
      activeChartInstance.destroy();
      activeChartInstance = null;
    }

    activeGrid.classList.remove('hidden');
    activeTakeover.remove();
    activeTakeover = null;
    activeGrid = null;
  }

  function openTakeover(card: HTMLElement) {
    if (activeTakeover) closeTakeover();

    const grid = card.closest('.stat-grid') as HTMLElement;
    if (!grid) return;

    const template = document.getElementById('stat-takeover-template') as HTMLTemplateElement;
    if (!template) return;

    const detailsStr = card.dataset.statDetails || '';
    let details: Details | null = null;
    try { details = JSON.parse(detailsStr); } catch {}
    if (!details?.history?.length) return;

    const takeoverEl = template.content.firstElementChild!.cloneNode(true) as HTMLElement;

    const label = card.dataset.statLabel || '';
    const value = card.dataset.statValue || '';
    const unit = card.dataset.statUnit || '';
    const description = card.dataset.statDescription || '';
    const change = card.dataset.statChange || '';
    const source = card.dataset.statSource || '';

    takeoverEl.querySelector('.takeover-label')!.textContent = label;
    takeoverEl.querySelector('.takeover-value')!.textContent = value;
    takeoverEl.querySelector('.takeover-unit')!.textContent = unit;
    takeoverEl.querySelector('.takeover-description')!.textContent = description || 'Podrobnosti o vývoji tohoto ukazatele.';

    if (change) {
      const changeNum = parseFloat(change);
      const changeEl = takeoverEl.querySelector('.takeover-change') as HTMLElement;
      const changeWrapper = takeoverEl.querySelector('.takeover-change-wrapper') as HTMLElement;
      changeEl.textContent = `${changeNum >= 0 ? '↑ +' : '↓ −'}${Math.abs(changeNum)}%`;
      changeEl.className = `takeover-change inline-flex items-center gap-1 text-sm font-semibold px-3 py-1 rounded-lg tabular-nums ${changeNum >= 0 ? 'bg-emerald-50 text-emerald-700' : 'bg-red-50 text-red-600'}`;
      changeWrapper.classList.remove('hidden');
    }

    if (source) {
      takeoverEl.querySelector('.takeover-source')!.textContent = source;
      takeoverEl.querySelector('.takeover-source-wrapper')!.classList.remove('hidden');
    }

    const chartTitle = details.chartLabel || 'Historický vývoj';
    takeoverEl.querySelector('.takeover-chart-title')!.textContent = chartTitle;

    takeoverEl.querySelector('.takeover-close')!.addEventListener('click', closeTakeover);

    activeGrid = grid;
    grid.classList.add('hidden');
    grid.parentElement!.appendChild(takeoverEl);
    activeTakeover = takeoverEl;

    const canvas = activeTakeover.querySelector('.takeover-chart') as HTMLCanvasElement;

    populateTable(activeTakeover, details!.history!);

    requestAnimationFrame(() => {
      renderChart(canvas, details!.history!, chartTitle);
    });
  }

  // Bind events
  document.querySelectorAll('.stat-card[data-has-details="true"]').forEach(card => {
    card.addEventListener('click', () => openTakeover(card as HTMLElement));
    card.addEventListener('keydown', (e) => {
      if (e instanceof KeyboardEvent && (e.key === 'Enter' || e.key === ' ')) {
        e.preventDefault();
        openTakeover(card as HTMLElement);
      }
    });
  });

  // ESC to close
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeTakeover();
  });
</script>

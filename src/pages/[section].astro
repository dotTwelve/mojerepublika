---
import Layout from '../layouts/Layout.astro';
import StatCard from '../components/StatCard.astro';
import CzechMap from '../components/CzechMap.astro';
import { sections, seoDescriptions, type Stat } from '../data/sections';

export function getStaticPaths() {
  return sections.map(s => ({
    params: { section: s.slug },
    props: { section: s },
  }));
}

const { section } = Astro.props;
const sectionIndex = sections.findIndex(s => s.id === section.id);
const prevSection = sectionIndex > 0 ? sections[sectionIndex - 1] : null;
const nextSection = sectionIndex < sections.length - 1 ? sections[sectionIndex + 1] : null;
const description = seoDescriptions[section.id] || section.data.description;
const showMap = section.id === 'demografie' || section.id === 'geografie';
---

<Layout
  title={`${section.data.title} – Statistiky ČR | Moje Republika`}
  description={description}
  canonicalPath={`/${section.slug}`}
>
  <section class="py-16 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <!-- Breadcrumb -->
      <nav class="mb-8 text-sm" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-muted">
          <li><a href="/" class="hover:text-accent transition-colors">Domů</a></li>
          <li><span class="text-border">/</span></li>
          <li class="text-primary font-medium">{section.data.title}</li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="mb-12">
        <div class="flex items-start justify-between gap-4">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={section.icon} />
            </div>
            <div>
              <h1 class="text-3xl sm:text-4xl font-bold text-primary">{section.data.title}</h1>
              <p class="text-muted mt-1 max-w-2xl">{section.data.description}</p>
            </div>
          </div>
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=https://mojerepublika.cz/${section.slug}`}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 border border-border hover:border-accent text-muted hover:text-accent text-xs font-medium rounded-lg transition-colors shrink-0"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            Sdílet
          </a>
        </div>
      </header>

      <!-- Map for demografie/geografie -->
      {showMap && (
        <div class="mb-12 max-w-xl">
          <CzechMap />
        </div>
      )}

      <!-- Stats grid + nav wrapper (stat-grid class needed for takeover JS) -->
      <div class="stat-grid-wrapper">
        <div class:list={[
          'stat-grid grid gap-6 items-start',
          section.data.stats.length <= 3 ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3' : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4'
        ]}>
          {section.data.stats.map((stat: Stat) => (
            <StatCard {...stat} />
          ))}
        </div>

        <!-- Prev/Next navigation (inside wrapper so it hides with takeover) -->
        <nav class="section-nav mt-16 pt-8 border-t border-border flex items-center justify-between">
          {prevSection ? (
            <a href={`/${prevSection.slug}`} class="group flex items-center gap-3 text-muted hover:text-primary transition-colors">
              <svg class="w-5 h-5 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"/>
              </svg>
              <div>
                <span class="block text-xs text-muted">Předchozí</span>
                <span class="block text-sm font-semibold">{prevSection.data.title}</span>
              </div>
            </a>
          ) : <div />}
          {nextSection ? (
            <a href={`/${nextSection.slug}`} class="group flex items-center gap-3 text-muted hover:text-primary transition-colors text-right">
              <div>
                <span class="block text-xs text-muted">Další</span>
                <span class="block text-sm font-semibold">{nextSection.data.title}</span>
              </div>
              <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </a>
          ) : <div />}
        </nav>
      </div>
    </div>
  </section>
</Layout>

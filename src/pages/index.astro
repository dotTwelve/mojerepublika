---
import Layout from '../layouts/Layout.astro';
import StatCard from '../components/StatCard.astro';
import CzechMap from '../components/CzechMap.astro';
import statsData from '../data/stats.json';

interface HistoryPoint {
  year: number;
  value: number;
}

interface Details {
  chartType?: string;
  chartLabel?: string;
  history?: HistoryPoint[];
}

interface Stat {
  id: string;
  label: string;
  value: string | number;
  unit?: string;
  description?: string;
  source?: string;
  change?: number;
  highlight?: boolean;
  details?: Details;
}

interface Section {
  title: string;
  description: string;
  stats: Stat[];
}

const { demografie, ekonomika, geografie, vzdelani, zdravotnictvi, zivotniProstredi, doprava, energie, turismus, bydleni, digitalizace, kultura, bezpecnost, zajimavosti, meta } = statsData as {
  meta: { lastUpdated: string; version: string };
  demografie: Section;
  ekonomika: Section;
  geografie: Section;
  vzdelani: Section;
  zdravotnictvi: Section;
  zivotniProstredi: Section;
  doprava: Section;
  energie: Section;
  turismus: Section;
  bydleni: Section;
  digitalizace: Section;
  kultura: Section;
  bezpecnost: Section;
  zajimavosti: Section;
};

// SVG icon markup per section (full inline SVG content, not just path)
const sectionIcons: Record<string, string> = {
  'demografie': '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  'ekonomika': '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
  'geografie': '<polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/>',
  'vzdelani': '<path d="M22 10v6"/><path d="M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 1.66 2.69 3 6 3s6-1.34 6-3v-5"/>',
  'zdravotnictvi': '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
  'zivotni-prostredi': '<path d="M17 22v-2"/><path d="M7 22v-2"/><path d="M12 2L7 7h3l-4 5h3l-5 6h16l-5-6h3l-4-5h3z"/>',
  'doprava': '<rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>',
  'energie': '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
  'turismus': '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>',
  'bydleni': '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  'digitalizace': '<rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>',
  'kultura': '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
  'bezpecnost': '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  'zajimavosti': '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>',
};

const sections = [
  { id: 'demografie', data: demografie, cols: 3 },
  { id: 'ekonomika', data: ekonomika, cols: 4, bg: true },
  { id: 'bydleni', data: bydleni, cols: 4 },
  { id: 'vzdelani', data: vzdelani, cols: 4, bg: true },
  { id: 'zdravotnictvi', data: zdravotnictvi, cols: 3 },
  { id: 'bezpecnost', data: bezpecnost, cols: 3, bg: true },
  { id: 'geografie', data: geografie, cols: 4 },
  { id: 'doprava', data: doprava, cols: 4, bg: true },
  { id: 'energie', data: energie, cols: 3 },
  { id: 'zivotni-prostredi', data: zivotniProstredi, cols: 4, bg: true },
  { id: 'digitalizace', data: digitalizace, cols: 4 },
  { id: 'kultura', data: kultura, cols: 4, bg: true },
  { id: 'turismus', data: turismus, cols: 3 },
  { id: 'zajimavosti', data: zajimavosti, cols: 4, bg: true },
];

const lastUpdate = new Date(meta.lastUpdated);
const now = new Date();
const monthsOld = Math.floor((now.getTime() - lastUpdate.getTime()) / (1000 * 60 * 60 * 24 * 30));
const isStale = monthsOld > 12;
---

<Layout title="Moje Republika – Statistiky České republiky v číslech | Otevřená data">
  <!-- Hero — Bento Grid -->
  <section class="relative bg-surface py-10 sm:py-16 lg:py-20 overflow-hidden">
    <!-- Top accent line -->
    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-czech-blue via-accent to-czech-red"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <!-- Headline -->
      <div class="text-center mb-10 sm:mb-14">
        <span class="inline-block text-xs font-semibold text-accent uppercase tracking-[0.2em] mb-3">
          Česká republika v číslech
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold text-czech-blue tracking-tight leading-[0.95]">
          Moje Republika
        </h1>
        <p class:list={['text-sm mt-3', isStale ? 'text-amber-600' : 'text-muted/60']}>
          {isStale && (
            <svg class="w-4 h-4 inline-block mr-1 -mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"/>
            </svg>
          )}
          Aktualizace {lastUpdate.toLocaleDateString('cs-CZ')}
          {isStale && <span class="font-medium"> — data starší než rok</span>}
        </p>
      </div>

      <!-- Bento Grid -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 auto-rows-[140px] sm:auto-rows-[160px]">

        <!-- Big stat: Population — spans 2 cols, 1 row -->
        <div class="bento-card col-span-2 row-span-1 bg-czech-blue text-white rounded-2xl p-6 flex flex-col justify-between relative overflow-hidden group">
          <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-accent/10 rounded-full"></div>
          <span class="text-xs font-semibold text-white/50 uppercase tracking-wider">Počet obyvatel</span>
          <div class="flex items-baseline gap-2">
            <span class="font-display text-5xl sm:text-6xl font-bold tabular-nums counter" data-target="10.9" data-decimals="1">0</span>
            <span class="text-xl text-white/60">mil.</span>
          </div>
        </div>

        <!-- GDP -->
        <div class="bento-card bg-white rounded-2xl p-5 flex flex-col justify-between border border-border hover:shadow-md transition-shadow">
          <span class="text-xs font-semibold text-muted uppercase tracking-wider">HDP</span>
          <div>
            <span class="font-display text-3xl sm:text-4xl font-bold text-czech-blue tabular-nums counter" data-target="290">0</span>
            <span class="text-sm text-muted ml-1">mld. €</span>
          </div>
          <span class="inline-flex items-center text-xs font-semibold text-emerald-600 tabular-nums">↑ +1,1%</span>
        </div>

        <!-- Area -->
        <div class="bento-card bg-white rounded-2xl p-5 flex flex-col justify-between border border-border hover:shadow-md transition-shadow">
          <span class="text-xs font-semibold text-muted uppercase tracking-wider">Rozloha</span>
          <div>
            <span class="font-display text-3xl sm:text-4xl font-bold text-czech-blue tabular-nums counter" data-target="78871" data-separator="true">0</span>
            <span class="block text-sm text-muted mt-1">km²</span>
          </div>
          <span class="text-xs text-muted">14 krajů</span>
        </div>

        <!-- Map — spans 2 cols, 2 rows, no card styling -->
        <div class="col-span-2 row-span-2 p-2 sm:p-4">
          <CzechMap />
        </div>

        <!-- Life expectancy -->
        <div class="bento-card bg-gradient-to-br from-accent/5 to-accent/10 rounded-2xl p-5 flex flex-col justify-between border border-accent/10">
          <span class="text-xs font-semibold text-accent uppercase tracking-wider">Délka života</span>
          <div>
            <span class="font-display text-3xl sm:text-4xl font-bold text-czech-blue tabular-nums counter" data-target="79.4" data-decimals="1">0</span>
            <span class="text-sm text-muted ml-1">let</span>
          </div>
          <span class="text-xs text-muted">Průměr EU: 80,1</span>
        </div>

        <!-- Tourists -->
        <div class="bento-card bg-white rounded-2xl p-5 flex flex-col justify-between border border-border hover:shadow-md transition-shadow">
          <span class="text-xs font-semibold text-muted uppercase tracking-wider">Turistů ročně</span>
          <div>
            <span class="font-display text-3xl sm:text-4xl font-bold text-czech-blue tabular-nums counter" data-target="22.8" data-decimals="1">0</span>
            <span class="text-sm text-muted ml-1">mil.</span>
          </div>
          <span class="inline-flex items-center text-xs font-semibold text-emerald-600 tabular-nums">↑ +3,6%</span>
        </div>

        <!-- CTA row — spans 2 cols -->
        <div class="col-span-2 flex flex-col sm:flex-row items-start sm:items-center gap-3 py-2">
          <p class="text-muted text-sm leading-relaxed flex-1">
            Otevřená data, otevřený zdrojový kód. Prozkoumejte 9 tematických sekcí.
          </p>
          <div class="flex gap-2 shrink-0">
            <a
              href="#demografie"
              class="inline-flex items-center gap-2 px-4 py-2 bg-czech-blue hover:bg-czech-blue/90 text-white text-sm font-medium rounded-lg transition-colors"
            >
              Prozkoumat data
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </a>
            <a
              href="https://www.facebook.com/sharer/sharer.php?u=https://mojerepublika.cz"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 border border-border hover:border-accent text-muted hover:text-accent text-sm font-medium rounded-lg transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              Sdílet
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {sections.map((section, index) => (
    <section
      class:list={['py-16 sm:py-24', section.bg ? 'bg-surface' : 'bg-white']}
      id={section.id}
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <header class="mb-12">
          <div class="flex items-center gap-4">
            <span class="text-5xl sm:text-6xl font-display font-bold text-border select-none leading-none">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <div class="flex items-center gap-2">
                {sectionIcons[section.id] && (
                  <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={sectionIcons[section.id]} />
                )}
                <h2 class="text-2xl sm:text-3xl font-bold text-czech-blue">{section.data.title}</h2>
              </div>
              <p class="text-muted mt-1 max-w-2xl">
                {section.data.description}
              </p>
            </div>
          </div>
        </header>

        <div class:list={[
          'stat-grid grid gap-4 sm:gap-6 items-start',
          section.cols === 4 ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4' : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3'
        ]}>
          {section.data.stats.map((stat: Stat) => (
            <StatCard {...stat} />
          ))}
        </div>
      </div>
    </section>
  ))}
</Layout>

<script>
  // Animated counters
  function animateCounters() {
    const counters = document.querySelectorAll('.counter');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        if (el.dataset.animated) return;
        el.dataset.animated = 'true';

        const target = parseFloat(el.dataset.target || '0');
        const decimals = parseInt(el.dataset.decimals || '0');
        const useSeparator = el.dataset.separator === 'true';

        if (prefersReducedMotion) {
          el.textContent = useSeparator ? target.toLocaleString('cs-CZ') : target.toFixed(decimals).replace('.', ',');
          return;
        }

        const duration = 1200;
        const start = performance.now();

        function update(now: number) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          // Ease out cubic
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = eased * target;

          if (useSeparator) {
            el.textContent = Math.round(current).toLocaleString('cs-CZ');
          } else if (decimals > 0) {
            el.textContent = current.toFixed(decimals).replace('.', ',');
          } else {
            el.textContent = Math.round(current).toString();
          }

          if (progress < 1) {
            requestAnimationFrame(update);
          }
        }

        requestAnimationFrame(update);
        observer.unobserve(el);
      });
    }, { threshold: 0.3 });

    counters.forEach(c => observer.observe(c));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', animateCounters);
  } else {
    animateCounters();
  }
</script>

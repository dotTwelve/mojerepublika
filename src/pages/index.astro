---
import Layout from '../layouts/Layout.astro';
import CzechMap from '../components/CzechMap.astro';
import { sections, meta, type Stat } from '../data/sections';

const lastUpdate = new Date(meta.lastUpdated);
const now = new Date();
const monthsOld = Math.floor((now.getTime() - lastUpdate.getTime()) / (1000 * 60 * 60 * 24 * 30));
const isStale = monthsOld > 12;
---

<Layout title="Moje Republika – Statistiky České republiky v číslech | Otevřená data">
  <!-- Hero — Bento Grid -->
  <section class="relative bg-surface py-10 sm:py-16 lg:py-20 overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-czech-blue via-accent to-czech-red"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10 sm:mb-14">
        <span class="inline-block text-xs font-semibold text-accent uppercase tracking-[0.2em] mb-3">
          Česká republika v číslech
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold text-primary tracking-tight leading-[0.95]">
          Moje Republika
        </h1>
        <p class:list={['text-sm mt-3', isStale ? 'text-amber-600' : 'text-muted/60']}>
          {isStale && (
            <svg class="w-4 h-4 inline-block mr-1 -mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"/>
            </svg>
          )}
          Aktualizace {lastUpdate.toLocaleDateString('cs-CZ')}
          {isStale && <span class="font-medium"> — data starší než rok</span>}
        </p>
      </div>

      <!-- Split hero: Map left, Stats right -->
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">
        <!-- Map -->
        <div class="order-2 lg:order-1">
          <CzechMap />
        </div>

        <!-- Stats -->
        <div class="order-1 lg:order-2 space-y-4">
          <!-- Population (hero stat) -->
          <div class="bg-primary text-primary-text rounded-2xl p-6 relative overflow-hidden">
            <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-accent/10 rounded-full"></div>
            <span class="text-xs font-semibold text-primary-text/50 uppercase tracking-wider">Počet obyvatel</span>
            <div class="flex items-baseline gap-2 mt-2">
              <span class="font-display text-5xl sm:text-6xl font-bold tabular-nums counter" data-target="10.9" data-decimals="1">0</span>
              <span class="text-xl text-primary-text/60">mil.</span>
            </div>
          </div>

          <!-- 2x2 grid of key stats -->
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-card rounded-xl p-4 border border-border">
              <span class="text-xs font-semibold text-muted uppercase tracking-wider">HDP</span>
              <div class="mt-1">
                <span class="font-display text-2xl sm:text-3xl font-bold text-primary tabular-nums counter" data-target="290">0</span>
                <span class="text-sm text-muted ml-1">mld. €</span>
              </div>
              <span class="inline-flex items-center text-xs font-semibold text-positive tabular-nums mt-1">↑ +1,1%</span>
            </div>

            <div class="bg-card rounded-xl p-4 border border-border">
              <span class="text-xs font-semibold text-muted uppercase tracking-wider">Rozloha</span>
              <div class="mt-1">
                <span class="font-display text-2xl sm:text-3xl font-bold text-primary tabular-nums counter" data-target="78871" data-separator="true">0</span>
                <span class="block text-xs text-muted mt-1">km² · 14 krajů</span>
              </div>
            </div>

            <div class="bg-card rounded-xl p-4 border border-accent/10">
              <span class="text-xs font-semibold text-accent uppercase tracking-wider">Délka života</span>
              <div class="mt-1">
                <span class="font-display text-2xl sm:text-3xl font-bold text-primary tabular-nums counter" data-target="79.4" data-decimals="1">0</span>
                <span class="text-sm text-muted ml-1">let</span>
              </div>
              <span class="text-xs text-muted mt-1">Průměr EU: 80,1</span>
            </div>

            <div class="bg-card rounded-xl p-4 border border-border">
              <span class="text-xs font-semibold text-muted uppercase tracking-wider">Turistů</span>
              <div class="mt-1">
                <span class="font-display text-2xl sm:text-3xl font-bold text-primary tabular-nums counter" data-target="22.8" data-decimals="1">0</span>
                <span class="text-sm text-muted ml-1">mil./rok</span>
              </div>
              <span class="inline-flex items-center text-xs font-semibold text-positive tabular-nums mt-1">↑ +3,6%</span>
            </div>
          </div>

          <!-- CTA -->
          <div class="flex flex-wrap gap-3 pt-2">
            <a
              href="#sekce"
              class="inline-flex items-center gap-2 px-4 py-2 bg-accent hover:bg-accent/90 text-primary-text text-sm font-medium rounded-lg transition-colors"
            >
              Prozkoumat data
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </a>
            <a
              href="https://www.facebook.com/sharer/sharer.php?u=https://mojerepublika.cz"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 border border-border hover:border-accent text-muted hover:text-accent text-sm font-medium rounded-lg transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              Sdílet
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section previews -->
  <section class="py-16 sm:py-24" id="sekce">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <header class="mb-12 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-primary">Prozkoumejte data</h2>
        <p class="text-muted mt-2">14 tematických sekcí s ověřenými statistikami</p>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {sections.map((section) => {
          const highlightStat = section.data.stats.find((s: Stat) => s.highlight) || section.data.stats[0];
          return (
            <a
              href={`/${section.slug}`}
              class="group bg-card border border-border rounded-xl p-6 hover:shadow-lg hover:border-accent/30 transition-all"
            >
              <!-- Icon + Title -->
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-lg bg-surface-alt group-hover:bg-accent/10 flex items-center justify-center shrink-0 transition-colors">
                  <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={section.icon} />
                </div>
                <div>
                  <h3 class="text-lg font-bold text-primary group-hover:text-accent transition-colors">{section.data.title}</h3>
                  <p class="text-xs text-muted">{section.data.stats.length} statistik</p>
                </div>
              </div>

              <!-- Highlight stat -->
              <div class="mb-3">
                <span class="text-xs font-semibold text-muted uppercase tracking-wider">{highlightStat.label}</span>
                <div class="font-display text-3xl font-bold text-primary mt-1 tabular-nums">
                  {highlightStat.value}
                  {highlightStat.unit && <span class="text-base text-muted font-body font-normal ml-1">{highlightStat.unit}</span>}
                </div>
                {highlightStat.change !== undefined && (
                  <span class:list={['inline-flex items-center text-xs font-semibold mt-1 tabular-nums', highlightStat.change >= 0 ? 'text-emerald-600' : 'text-red-600']}>
                    {highlightStat.change >= 0 ? '↑ +' : '↓ −'}{Math.abs(highlightStat.change)}%
                  </span>
                )}
              </div>

              <!-- Description -->
              <p class="text-sm text-muted leading-relaxed line-clamp-2">{section.data.description}</p>

              <!-- Arrow -->
              <div class="mt-4 flex items-center gap-1 text-xs font-medium text-accent/60 group-hover:text-accent transition-colors">
                Zobrazit vše
                <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<script>
  // Animated counters
  function animateCounters() {
    const counters = document.querySelectorAll('.counter');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        if (el.dataset.animated) return;
        el.dataset.animated = 'true';

        const target = parseFloat(el.dataset.target || '0');
        const decimals = parseInt(el.dataset.decimals || '0');
        const useSeparator = el.dataset.separator === 'true';

        if (prefersReducedMotion) {
          el.textContent = useSeparator ? target.toLocaleString('cs-CZ') : target.toFixed(decimals).replace('.', ',');
          return;
        }

        const duration = 1200;
        const start = performance.now();

        function update(now: number) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = eased * target;

          if (useSeparator) {
            el.textContent = Math.round(current).toLocaleString('cs-CZ');
          } else if (decimals > 0) {
            el.textContent = current.toFixed(decimals).replace('.', ',');
          } else {
            el.textContent = Math.round(current).toString();
          }

          if (progress < 1) {
            requestAnimationFrame(update);
          }
        }

        requestAnimationFrame(update);
        observer.unobserve(el);
      });
    }, { threshold: 0.3 });

    counters.forEach(c => observer.observe(c));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', animateCounters);
  } else {
    animateCounters();
  }
</script>
